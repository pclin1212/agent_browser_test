{
  "name": "mini-forum-02-category-filter",
  "env": "mini-forum",
  "category": "topics",
  "base_url": "http://127.0.0.1:8020",
  "start_url": "{BASE}/index.html",
  "steps": [
    ["open", "{start_url}"],
    ["wait", "--load", "networkidle"],
    ["click", "a.category-link[data-cat='Tech']"],
    ["wait", "--load", "networkidle"]
  ],
  "steps_note": "分类过滤是真实链接导航（?category=Tech）；Tech 分类静态推演只有 2 个帖子",
  "asserts": [
    {
      "desc": "Tech 分类下两个帖子都在",
      "cmd": ["get", "text", "#topic-list"],
      "op": "contains_all",
      "expect": [
        "Chrome hangs with more than 20 tabs on macOS",
        "NodeBB vs Discourse: a performance comparison"
      ]
    },
    {
      "desc": "Help 分类的帖子被过滤掉",
      "cmd": ["get", "text", "#topic-list"],
      "op": "re",
      "expect": "(?s)^(?!.*Postgres query slow after upgrading to 14)"
    }
  ]
}
